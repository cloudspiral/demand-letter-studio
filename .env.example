# Local application
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://steno:steno@127.0.0.1:5438/steno
STORAGE_DIR=.data/storage
DEMO_ASSET_DIR=.
WEB_ORIGIN=http://127.0.0.1:5173

# openai | anthropic | mock
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=high
OPENAI_STORE=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Required only for Anthropic identity-linked keys; ordinary API keys leave this blank.
ANTHROPIC_WORKSPACE_ID=

# Document worker
PYTHON_BIN=services/document-worker/.venv/bin/python
